+{"id":"2h-pk-lcs-cairan-otak__latihan-responsi-analisis-lcs-v3-isian","title":"Latihan Responsi Analisis LCS V3 (isian)","category":"2H PK - LCS Cairan Otak","questions":[{"id":"QI1","category":"Soal Isian","question":"LCS dihasilkan terutama oleh sekresi dari struktur apa?","questionImages":[],"options":{},"answer":"Pleksus choroideus","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI2","category":"Soal Isian","question":"Selain pleksus choroideus, produksi minor LCS berasal dari sel apa?","questionImages":[],"options":{},"answer":"Sel ependimal","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI3","category":"Soal Isian","question":"LCS mengalir pada ruang antara arakhnoid mater dan pia mater yang disebut apa?","questionImages":[],"options":{},"answer":"Ruang (spasium) subarakhnoid","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI4","category":"Soal Isian","question":"Berapa laju pembentukan LCS per jam?","questionImages":[],"options":{},"answer":"±20 mL/jam (±500 mL/hari)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI5","category":"Soal Isian","question":"Berapa volume normal LCS pada dewasa?","questionImages":[],"options":{},"answer":"90–150 mL","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI6","category":"Soal Isian","question":"Berapa volume normal LCS pada neonatus?","questionImages":[],"options":{},"answer":"10–60 mL","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI7","category":"Soal Isian","question":"Gangguan aliran pembentukan/reabsorpsi LCS menyebabkan akumulasi cairan dan kondisi apa?","questionImages":[],"options":{},"answer":"Hidrosefalus","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI8","category":"Soal Isian","question":"Pada dewasa, pungsi lumbal dilakukan pada spasium berapa?","questionImages":[],"options":{},"answer":"L2–L3 atau L3–L4","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI9","category":"Soal Isian","question":"Pada anak, pungsi lumbal dilakukan pada spasium berapa?","questionImages":[],"options":{},"answer":"L4–L5","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI10","category":"Soal Isian","question":"Sampel LCS ditampung dalam berapa tabung steril?","questionImages":[],"options":{},"answer":"3 tabung","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI11","category":"Soal Isian","question":"Tabung ke berapa yang digunakan untuk pemeriksaan mikrobiologi, dan tabung ke berapa untuk pemeriksaan mikroskopis sel?","questionImages":[],"options":{},"answer":"Tabung 2 untuk mikrobiologi; tabung 3 untuk mikroskopis (hematologi/sel)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI12","category":"Soal Isian","question":"Pada traumatic tap, gambaran darah dari tabung 1 ke tabung 3 menunjukkan pola seperti apa?","questionImages":[],"options":{},"answer":"Semakin berkurang/semakin jernih (gradasi menurun)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI13","category":"Soal Isian","question":"Pada perdarahan subarakhnoid (SAH), pola darah pada ketiga tabung menunjukkan apa?","questionImages":[],"options":{},"answer":"Sama/tetap merah pada semua tabung (tidak ada gradasi)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI14","category":"Soal Isian","question":"Berapa nilai normal protein LCS?","questionImages":[],"options":{},"answer":"15–45 mg/dL","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI15","category":"Soal Isian","question":"Berapa nilai normal glukosa LCS?","questionImages":[],"options":{},"answer":"50–80 mg/dL","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI16","category":"Soal Isian","question":"Berapa nilai normal laktat LCS?","questionImages":[],"options":{},"answer":"10–22 mg/dL","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI17","category":"Soal Isian","question":"Berapa rasio albumin:globulin normal pada LCS?","questionImages":[],"options":{},"answer":"8:1","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI18","category":"Soal Isian","question":"Warna kuning pada LCS dapat menunjukkan kondisi apa?","questionImages":[],"options":{},"answer":"Pembongkaran darah (xanthochromia), hiperbilirubinemia, atau peningkatan protein","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI19","category":"Soal Isian","question":"Warna hijau pada LCS dapat menunjukkan kondisi apa?","questionImages":[],"options":{},"answer":"Hiperbilirubinemia atau cairan purulen (infeksi)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI20","category":"Soal Isian","question":"Perhatikan gambar berikut.Skala penilaian kekeruhan LCS dimulai dari 0 hingga berapa +?","questionImages":["images/packages/2h-pk-lcs-cairan-otak__latihan-responsi-analisis-lcs-v3-isian/img-001.png"],"options":{},"answer":"4+ (skala 0, 1+, 2+, 3+, 4+)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI21","category":"Soal Isian","question":"Bekuan pada LCS dapat terbentuk akibat peningkatan kadar apa?","questionImages":[],"options":{},"answer":"Fibrinogen","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI22","category":"Soal Isian","question":"Xanthochromia pada LCS disebabkan oleh degradasi apa?","questionImages":[],"options":{},"answer":"Eritrosit yang lisis (pelepasan hemoglobin) atau peningkatan bilirubin","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI23","category":"Soal Isian","question":"Reagen apa yang digunakan pada pemeriksaan Pandy?","questionImages":[],"options":{},"answer":"Reagen Pandy (fenol jenuh)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI24","category":"Soal Isian","question":"Prinsip pemeriksaan Pandy adalah mendeteksi apa dalam LCS?","questionImages":[],"options":{},"answer":"Albumin dan globulin","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI25","category":"Soal Isian","question":"Prinsip pemeriksaan Nonne-Apelt adalah mendeteksi apa dalam LCS?","questionImages":[],"options":{},"answer":"Globulin","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI26","category":"Soal Isian","question":"Hasil Nonne-Apelt yang menunjukkan opalesensi setelah dikocok termasuk derajat berapa?","questionImages":[],"options":{},"answer":"2+","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI27","category":"Soal Isian","question":"Berapa nilai normal jumlah sel LCS pada dewasa?","questionImages":[],"options":{},"answer":"0–5 sel/µL","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI28","category":"Soal Isian","question":"Apa rumus konversi jumlah sel yang dihitung pada bilik hitung menjadi sel/µL?","questionImages":[],"options":{},"answer":"Jumlah sel yang dihitung × 5/4","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI29","category":"Soal Isian","question":"Kondisi disosiasi sitoalbumin ditandai dengan apa?","questionImages":[],"options":{},"answer":"Peningkatan protein LCS tanpa disertai peningkatan jumlah sel","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI30","category":"Soal Isian","question":"Pada meningitis bakterial, jenis sel apa yang dominan di LCS?","questionImages":[],"options":{},"answer":"Sel PMN (neutrofil)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI31","category":"Soal Isian","question":"Pada meningitis viral, jenis sel apa yang dominan di LCS?","questionImages":[],"options":{},"answer":"Sel MN (limfosit)","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI32","category":"Soal Isian","question":"Pada meningitis bakterial, jumlah sel LCS biasanya berapa?","questionImages":[],"options":{},"answer":"≥1000/mm³","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI33","category":"Soal Isian","question":"Pada meningitis viral, jumlah sel LCS biasanya berapa?","questionImages":[],"options":{},"answer":"<100/mm³","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI34","category":"Soal Isian","question":"Pada meningitis bakterial, opening pressure biasanya menunjukkan apa?","questionImages":[],"options":{},"answer":"Meningkat","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI35","category":"Soal Isian","question":"Case 1 (laki-laki 22 tahun, demam, kaku kuduk (+), Kernig (+), leukositosis neutrofilik, procalcitonin tinggi): dari 9 kotak besar bilik hitung ditemukan 1500 sel. Berapa jumlah sel per µL?","questionImages":[],"options":{},"answer":"1500 × 5/4 = 1875 sel/µL","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI36","category":"Soal Isian","question":"Case 1 (lanjutan): berdasarkan gambar sediaan sel LCS berikut, sel apakah yang mendominasi?","questionImages":["images/packages/2h-pk-lcs-cairan-otak__latihan-responsi-analisis-lcs-v3-isian/img-002.png"],"options":{},"answer":"Sel PMN (neutrofil) — sesuai gambaran meningitis bakterial akut","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI37","category":"Soal Isian","question":"Case 2 (anak perempuan 2 tahun, faringitis, kaku kuduk (+), Kernig (−)/Brudzinski (−), limfosit 51%, procalcitonin rendah): berdasarkan gambar sediaan sel LCS berikut, sel apakah yang mendominasi?","questionImages":["images/packages/2h-pk-lcs-cairan-otak__latihan-responsi-analisis-lcs-v3-isian/img-003.png"],"options":{},"answer":"Sel MN (limfosit) — sesuai gambaran meningitis viral","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI38","category":"Soal Isian","question":"Case 3 (perempuan 23 tahun HIV positif, nyeri kepala progresif, tanpa kaku kuduk): dari 9 kotak besar bilik hitung ditemukan 16 sel. Berapa jumlah sel per µL?","questionImages":[],"options":{},"answer":"16 × 5/4 = 20 sel/µL","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI39","category":"Soal Isian","question":"Case 3 (lanjutan): berdasarkan gambar sediaan sel LCS berikut, sel apakah yang mendominasi?","questionImages":["images/packages/2h-pk-lcs-cairan-otak__latihan-responsi-analisis-lcs-v3-isian/img-004.png"],"options":{},"answer":"Sel MN (limfosit) — sesuai gambaran meningitis fungal/TB pada pasien HIV","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true},{"id":"QI40","category":"Soal Isian","question":"Case 4 (perempuan 67 tahun, Ca paru dalam terapi imunoterapi, kelemahan ekstremitas, protein LCS 197 mg/dL namun dari 9 kotak besar hanya ditemukan 4 sel): berdasarkan gambar sediaan sel LCS berikut, sel apakah yang mendominasi, dan kondisi apa yang tercermin dari kombinasi hasil ini?","questionImages":["images/packages/2h-pk-lcs-cairan-otak__latihan-responsi-analisis-lcs-v3-isian/img-005.png"],"options":{},"answer":"Sel MN (limfosit), jumlah normal; mencerminkan disosiasi sitoalbumin (protein meningkat, sel tidak meningkat), sugestif Guillain-Barré syndrome/CIDP","explanation":"","explanationImages":[],"isBroken":false,"isIsian":true}]}
