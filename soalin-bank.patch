@@ -0,0 +1 @@
+{"id":"latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2","title":"Latihan Pemeriksaan Tanda Meningeal - V2","category":"Latihan KK7","questions":[{"id":"Q1","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Refleks patologis secara fisiologis dapat dijumpai pada kelompok berikut, KECUALI:","questionImages":[],"options":{"A":"Bayi","B":"Anak usia 4-6 tahun","C":"Anak usia besar dengan sistem piramidal yang telah bermielinisasi penuh","D":"Anak balita","E":"Neonatus"},"answer":"C","explanation":"Refleks patologis jarang dijumpai pada individu normal, kecuali pada bayi dan anak kecil (usia 4-6 tahun ke bawah) karena sistem piramidal mereka belum bermielinisasi penuh. Begitu sistem piramidal sudah matang, refleks ini seharusnya tidak muncul lagi secara fisiologis.","explanationImages":[],"isBroken":false},{"id":"Q2","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pada orang dewasa yang sehat, munculnya refleks patologis mengindikasikan adanya lesi pada:","questionImages":[],"options":{"A":"Lower Motor Neuron (LMN)","B":"Upper Motor Neuron (UMN)","C":"Neuromuscular junction","D":"Otot rangka","E":"Saraf perifer murni"},"answer":"B","explanation":"Pada orang dewasa, refleks patologis timbul sebagai tanda lesi Upper Motor Neuron (UMN), karena normalnya gerakan reflektorik ini dikendalikan (ditekan) oleh sistem piramidal yang intak.","explanationImages":[],"isBroken":false},{"id":"Q3","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Posisi pasien yang tepat saat pemeriksaan refleks Hoffmann dan Tromner adalah:","questionImages":[],"options":{"A":"Tidur tengkurap dengan tangan di bawah dada","B":"Relaks, tidur terlentang atau duduk dengan tangan pasien dalam keadaan santai","C":"Tidur miring dengan tangan di atas kepala","D":"Duduk tegak dengan tangan mengepal","E":"Berdiri dengan lengan lurus ke depan"},"answer":"B","explanation":"Kedua refleks ini membutuhkan tangan pasien dalam keadaan santai (posisi tidur terlentang atau duduk), agar respons fleksi jari yang muncul murni akibat rangsang refleks, bukan tegangan otot volunter.","explanationImages":[],"isBroken":false},{"id":"Q4","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Manuver pemeriksa pada refleks Hoffmann adalah:","questionImages":[],"options":{"A":"Menarik ibu jari pasien ke arah lateral","B":"Menyentil ujung jari tengah pasien","C":"Mengetuk tendon patela dengan palu refleks","D":"Menggores ujung kuku jari tengah pasien dengan ujung kuku ibu jari pemeriksa","E":"Menekan telapak tangan pasien"},"answer":"D","explanation":"Pemeriksa memegang jari tengah tangan pasien dengan tangan kiri, lalu memberi goresan pada ujung kuku jari tengah tersebut dengan ujung kuku ibu jari tangan kanan pemeriksa. Ini berbeda dengan Tromner yang menggunakan sentilan, bukan goresan.","explanationImages":[],"isBroken":false},{"id":"Q5","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Refleks Hoffmann dikatakan positif apabila muncul: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-001.png"],"options":{"A":"Tidak ada respons sama sekali","B":"Fleksi pada falang distal jari-jari lain pada tangan yang sama","C":"Abduksi ibu jari kaki","D":"Dorsofleksi pergelangan tangan","E":"Ekstensi seluruh jari tangan"},"answer":"B","explanation":"Apabila timbul fleksi pada falang distal jari-jari lain pada tangan yang sama saat jari tengah digores, maka Refleks Hoffmann dinyatakan positif.","explanationImages":[],"isBroken":false},{"id":"Q6","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Gambar berikut menunjukkan pemeriksaan refleks patologis ekstremitas atas yang dilakukan dengan cara menggores ujung kuku jari tengah pasien. Pemeriksaan ini disebut refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-002.png"],"options":{"A":"Rossolimo","B":"Gordon","C":"Hoffmann","D":"Tromner","E":"Mendel Bechterew"},"answer":"C","explanation":"Gambar memperlihatkan pemeriksa memegang jari tengah pasien dan memberikan goresan pada ujung kuku — ini adalah teknik khas Refleks Hoffmann.","explanationImages":[],"isBroken":false},{"id":"Q7","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Perbedaan utama cara pemeriksaan refleks Tromner dibandingkan Hoffmann adalah:","questionImages":[],"options":{"A":"Tromner memerlukan palu refleks, Hoffmann tidak","B":"Tromner menilai respons pada ibu jari kaki","C":"Tromner menggunakan sentilan pada ujung jari tengah, sedangkan Hoffmann menggunakan goresan pada ujung kuku","D":"Tromner dilakukan pada ekstremitas bawah","E":"Tromner dilakukan dalam posisi berdiri"},"answer":"C","explanation":"Kedua refleks sama-sama menilai fleksi falang distal jari-jari lain, namun rangsangnya berbeda: Hoffmann memakai goresan pada kuku, Tromner memakai sentilan pada ujung jari.","explanationImages":[],"isBroken":false},{"id":"Q8","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Manuver pada gambar berikut — memegang jari tengah pasien lalu memberikan sentilan pada ujung jarinya — merupakan pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-003.png"],"options":{"A":"Hoffmann","B":"Chaddock","C":"Babinski","D":"Bing","E":"Tromner"},"answer":"E","explanation":"Sentilan pada ujung jari tengah (bukan goresan pada kuku) adalah ciri khas Refleks Tromner.","explanationImages":[],"isBroken":false},{"id":"Q9","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Refleks Babinski, Chaddock, dan Oppenheim memiliki kesamaan dalam hal:","questionImages":[],"options":{"A":"Ketiganya mengevaluasi respons plantar","B":"Ketiganya dilakukan pada ekstremitas atas","C":"Ketiganya menggunakan palu refleks","D":"Ketiganya menilai refleks tendon dalam","E":"Ketiganya hanya bisa dilakukan pada posisi duduk"},"answer":"A","explanation":"Refleks Babinski, Chaddock, dan Oppenheim semuanya mengevaluasi respons plantar, meskipun cara membangkitkan rangsangnya berbeda-beda.","explanationImages":[],"isBroken":false},{"id":"Q10","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Respons plantar yang ABNORMAL pada rangsang Babinski/Chaddock/Oppenheim berupa:","questionImages":[],"options":{"A":"Tidak ada respons sama sekali","B":"Plantarfleksi seluruh jari kaki","C":"Kontraksi otot betis tanpa gerakan jari","D":"Fleksi cepat ibu jari kaki","E":"Ekstensi (dorsofleksi) ibu jari kaki disertai penyebaran jari-jari lain, sering disertai fleksi lutut dan pinggul"},"answer":"E","explanation":"Respons plantar normal adalah fleksi ibu jari kaki. Respons abnormal lebih lambat, berupa ekstensi ibu jari kaki dengan penyebaran jari-jari lain, sering disertai fleksi lutut dan pinggul — mengindikasikan disinhibisi spinal akibat lesi UMN.","explanationImages":[],"isBroken":false},{"id":"Q11","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Teknik pemeriksaan refleks Babinski dilakukan dengan cara:","questionImages":[],"options":{"A":"Menekuk maksimal jari IV kaki","B":"Menggores telapak kaki sepanjang sisi lateral plantar sampai pangkal ibu jari kaki","C":"Menusuk kulit pada metatarsal V","D":"Menekan m. gastrocnemius","E":"Mengetuk tendon achilles dengan palu refleks"},"answer":"B","explanation":"Goresan dilakukan pada telapak kaki sepanjang sisi lateral plantar sampai di pangkal ibu jari kaki, dengan tekanan cukup kuat namun tidak melukai.","explanationImages":[],"isBroken":false},{"id":"Q12","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Bila pada pemeriksaan Babinski, goresan yang dilakukan terlalu ke tengah telapak kaki sehingga tidak sengaja memicu refleks genggaman primitif, langkah yang tepat adalah:","questionImages":[],"options":{"A":"Mengulang goresan lebih ke tengah lagi","B":"Melanjutkan dengan pemeriksaan refleks Chaddock atau Oppenheim","C":"Menghentikan seluruh pemeriksaan refleks patologis","D":"Melaporkan hasil sebagai Babinski positif","E":"Mengganti posisi pasien menjadi duduk"},"answer":"B","explanation":"Usapan tidak boleh terlalu ke tengah karena dapat memicu refleks genggaman primitif secara tidak sengaja. Bila hal ini terjadi, pemeriksaan dilanjutkan dengan refleks Chaddock atau Oppenheim sebagai alternatif.","explanationImages":[],"isBroken":false},{"id":"Q13","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Gambar berikut memperlihatkan goresan pada sisi lateral telapak kaki hingga pangkal ibu jari kaki. Ini adalah pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-004.png"],"options":{"A":"Babinski","B":"Chaddock","C":"Schaeffer","D":"Gordon","E":"Oppenheim"},"answer":"A","explanation":"Goresan pada telapak kaki sisi lateral plantar sampai pangkal ibu jari kaki adalah ciri khas Refleks Babinski.","explanationImages":[],"isBroken":false},{"id":"Q14","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Rangsang pada pemeriksaan refleks Chaddock diberikan pada:","questionImages":[],"options":{"A":"Telapak kaki sisi lateral plantar","B":"m. gastrocnemius","C":"Metatarsal V dengan penusukan","D":"Dorsum pedis sepanjang sisi lateral (maleolus lateral) sampai dorsum pangkal ibu jari kaki","E":"Tendo achilles"},"answer":"D","explanation":"Goresan Chaddock dilakukan pada dorsum pedis, sepanjang sisi lateral dorsum pedis (maleolus lateral) sampai di dorsum pangkal ibu jari kaki — bukan pada telapak kaki seperti Babinski.","explanationImages":[],"isBroken":false},{"id":"Q15","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Goresan pada dorsum pedis di sepanjang maleolus lateral hingga dorsum pangkal ibu jari kaki, seperti pada gambar berikut, merupakan pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-005.png"],"options":{"A":"Gonda","B":"Chaddock","C":"Babinski","D":"Bing","E":"Rossolimo"},"answer":"B","explanation":"Lokasi goresan pada dorsum pedis (bukan telapak kaki) adalah ciri khas Refleks Chaddock.","explanationImages":[],"isBroken":false},{"id":"Q16","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Cara pemeriksaan refleks Oppenheim adalah dengan:","questionImages":[],"options":{"A":"Menggores telapak kaki","B":"Menekuk jari IV kaki secara maksimal","C":"Memijat tendon achilles","D":"Meletakkan sela jari II-III tangan kanan pemeriksa pada proksimal os tibia lalu melakukan dorongan/pengurutan ke arah kaudal","E":"Mengetuk dorsum pedis dengan palu refleks"},"answer":"D","explanation":"Sela jari II dan III tangan kanan pemeriksa diletakkan pada bagian proksimal os tibia pasien, lalu dilakukan dorongan dan penekanan (pengurutan) sepanjang os tibia ke arah kaudal.","explanationImages":[],"isBroken":false},{"id":"Q17","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pengurutan dengan sela jari II-III tangan pemeriksa di sepanjang os tibia ke arah kaudal, seperti pada gambar berikut, adalah pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-006.png"],"options":{"A":"Gordon","B":"Mendel Bechterew","C":"Schaeffer","D":"Bing","E":"Oppenheim"},"answer":"E","explanation":"Pengurutan sepanjang os tibia ke arah kaudal menggunakan sela jari II-III adalah ciri khas Refleks Oppenheim.","explanationImages":[],"isBroken":false},{"id":"Q18","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Refleks Schaeffer dibangkitkan dengan cara:","questionImages":[],"options":{"A":"Menekuk jari IV kaki","B":"Memijat/memencet tendo achilles","C":"Menekan proksimal os tibia","D":"Mengetuk plantar pedis dengan palu refleks","E":"Menggores telapak kaki"},"answer":"B","explanation":"Refleks Schaeffer dibangkitkan dengan pemijatan/pemencetan pada tendo achilles pasien.","explanationImages":[],"isBroken":false},{"id":"Q19","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pemijatan pada tendo achilles seperti terlihat pada gambar berikut merupakan pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-007.png"],"options":{"A":"Rossolimo","B":"Schaeffer","C":"Gonda","D":"Bing","E":"Gordon"},"answer":"B","explanation":"Pemijatan/pemencetan tendo achilles adalah ciri khas Refleks Schaeffer.","explanationImages":[],"isBroken":false},{"id":"Q20","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Refleks Gordon dibangkitkan dengan:","questionImages":[],"options":{"A":"Plantarfleksi maksimal jari IV kaki","B":"Penusukan ujung tumpul pada metatarsal V","C":"Goresan pada telapak kaki","D":"Ketukan palu refleks pada dorsum pedis","E":"Pemijatan/pemencetan adekuat pada m. gastrocnemius (otot betis)"},"answer":"E","explanation":"Refleks Gordon dibangkitkan dengan pemijatan/pemencetan adekuat pada m. gastrocnemius (otot betis) pasien.","explanationImages":[],"isBroken":false},{"id":"Q21","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pemijatan pada otot betis (m. gastrocnemius) seperti pada gambar berikut merupakan teknik pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-008.png"],"options":{"A":"Gonda","B":"Babinski","C":"Gordon","D":"Bing","E":"Schaeffer"},"answer":"C","explanation":"Pemijatan m. gastrocnemius (otot betis) adalah ciri khas Refleks Gordon.","explanationImages":[],"isBroken":false},{"id":"Q22","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Refleks Bing dibangkitkan dengan cara:","questionImages":[],"options":{"A":"Mengetuk plantar pedis bagian depan","B":"Penusukan kulit menggunakan ujung tumpul pada metatarsal V","C":"Menekuk maksimal jari IV kaki","D":"Memijat tendo achilles","E":"Mengetuk dorsum pedis di atas os kuboid"},"answer":"B","explanation":"Refleks Bing dibangkitkan dengan penusukan kulit menggunakan ujung tumpul pada metatarsal V pasien.","explanationImages":[],"isBroken":false},{"id":"Q23","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Penusukan dengan ujung tumpul pada daerah metatarsal V seperti gambar berikut adalah pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-009.png"],"options":{"A":"Chaddock","B":"Gonda","C":"Bing","D":"Mendel Bechterew","E":"Rossolimo"},"answer":"C","explanation":"Penusukan ujung tumpul pada metatarsal V adalah ciri khas Refleks Bing.","explanationImages":[],"isBroken":false},{"id":"Q24","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Refleks Gonda dibangkitkan dengan:","questionImages":[],"options":{"A":"Dorsofleksi maksimal pada jari I kaki","B":"Ketukan pada dorsum pedis","C":"Plantarfleksi maksimal pada jari IV kaki","D":"Pemijatan m. gastrocnemius","E":"Goresan pada dorsum pedis"},"answer":"C","explanation":"Refleks Gonda dibangkitkan dengan penekukan (plantarfleksi) maksimal pada jari IV kaki pasien.","explanationImages":[],"isBroken":false},{"id":"Q25","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Manuver penekukan (plantarfleksi) maksimal pada jari IV kaki seperti gambar berikut merupakan pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-010.png"],"options":{"A":"Oppenheim","B":"Schaeffer","C":"Gordon","D":"Gonda","E":"Bing"},"answer":"D","explanation":"Plantarfleksi maksimal jari IV kaki adalah ciri khas Refleks Gonda.","explanationImages":[],"isBroken":false},{"id":"Q26","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Cara membangkitkan refleks Mendel Bechterew adalah dengan:","questionImages":[],"options":{"A":"Mengetukkan palu refleks pada dorsum pedis di atas os kuboid kaki","B":"Menggores dorsum pedis","C":"Memencet tendo achilles","D":"Menusuk metatarsal V","E":"Menekan proksimal os tibia"},"answer":"A","explanation":"Refleks Mendel Bechterew dibangkitkan dengan pengetukan palu refleks pada dorsum pedis di atas os kuboid kaki pasien.","explanationImages":[],"isBroken":false},{"id":"Q27","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Interpretasi POSITIF refleks Mendel Bechterew dan Rossolimo berbeda dari kelompok Babinski, Chaddock, Oppenheim, Schaeffer, Gordon, Bing, dan Gonda, yaitu berupa:","questionImages":[],"options":{"A":"Fleksi (plantarfleksi) jari-jari kaki pada sendi interfalang","B":"Tidak ada respons jari kaki","C":"Abduksi jari II-V disertai dorsofleksi ibu jari kaki","D":"Kontraksi otot betis tanpa gerakan jari","E":"Ekstensi seluruh jari kaki"},"answer":"A","explanation":"Kelompok besar refleks patologis ekstremitas bawah (Babinski dkk.) positif bila muncul abduksi jari II-V disertai dorsofleksi ibu jari kaki. Sebaliknya, Mendel Bechterew dan Rossolimo dinyatakan positif bila muncul fleksi (plantarfleksi) jari-jari kaki pada sendi interfalang — pola responnya berkebalikan.","explanationImages":[],"isBroken":false},{"id":"Q28","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Ketukan palu refleks pada dorsum pedis di atas os kuboid, seperti pada gambar berikut, merupakan pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-011.png"],"options":{"A":"Rossolimo","B":"Gordon","C":"Mendel Bechterew","D":"Chaddock","E":"Bing"},"answer":"C","explanation":"Ketukan pada dorsum pedis di atas os kuboid adalah ciri khas Refleks Mendel Bechterew.","explanationImages":[],"isBroken":false},{"id":"Q29","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Refleks Rossolimo dibangkitkan dengan cara:","questionImages":[],"options":{"A":"Mengetuk plantar pedis bagian depan (daerah basis jari-jari kaki) dengan palu refleks","B":"Mengetuk dorsum pedis di atas os kuboid","C":"Menusuk metatarsal V","D":"Menggores telapak kaki sisi lateral","E":"Memijat m. gastrocnemius"},"answer":"A","explanation":"Refleks Rossolimo dibangkitkan dengan pengetukan palu refleks pada plantar pedis bagian depan kaki pasien (daerah basis jari-jari kaki).","explanationImages":[],"isBroken":false},{"id":"Q30","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Ketukan palu refleks pada plantar pedis bagian depan kaki seperti gambar berikut adalah pemeriksaan refleks: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-012.png"],"options":{"A":"Gonda","B":"Mendel Bechterew","C":"Schaeffer","D":"Rossolimo","E":"Bing"},"answer":"D","explanation":"Ketukan pada plantar pedis bagian depan (bukan dorsum pedis) adalah ciri khas Refleks Rossolimo.","explanationImages":[],"isBroken":false},{"id":"Q31","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tanda rangsang meningeal (TRM) paling sering dimunculkan oleh keadaan:","questionImages":[],"options":{"A":"Hipertensi kronik","B":"Dehidrasi berat","C":"Miopati primer","D":"Peradangan/inflamasi meninges akibat infeksi atau benda asing (misalnya darah pada ruang subarachnoid)","E":"Fraktur tulang belakang"},"answer":"D","explanation":"Tanda meningeal dimunculkan terutama saat terjadi peradangan/inflamasi pada meninges, yang dapat disebabkan oleh infeksi atau benda asing seperti darah pada spasium subarachnoid.","explanationImages":[],"isBroken":false},{"id":"Q32","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pemeriksaan kaku kuduk dikontraindikasikan pada pasien dengan:","questionImages":[],"options":{"A":"Demam tinggi","B":"Fotofobia","C":"Instabilitas cervical (misalnya riwayat trauma atau rheumatoid arthritis)","D":"Riwayat migrain","E":"Nyeri kepala ringan"},"answer":"C","explanation":"Pemeriksaan kaku kuduk dikontraindikasikan bila pasien memiliki instabilitas cervical, misalnya karena riwayat trauma atau penyakit lain seperti rheumatoid arthritis, karena gerakan fleksi/rotasi leher berisiko mencederai medula spinalis.","explanationImages":[],"isBroken":false},{"id":"Q33","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Kaku kuduk dinyatakan positif apabila:","questionImages":[],"options":{"A":"Dagu mudah menempel ke dada tanpa tahanan","B":"Pasien dapat duduk tanpa keluhan","C":"Leher dapat digelengkan bebas ke kedua sisi","D":"Ditemukan kekakuan/tahanan pada leher saat kepala difleksikan atau dirotasikan","E":"Tidak ada nyeri saat pergerakan leher"},"answer":"D","explanation":"Keadaan normal bila leher bergerak bebas dan dagu mudah menempel ke dada. Bila ditemukan kekakuan pada leher, hal ini menunjukkan kaku kuduk positif.","explanationImages":[],"isBroken":false},{"id":"Q34","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Kaku kuduk positif dapat ditemukan pada kondisi berikut, KECUALI:","questionImages":[],"options":{"A":"Perdarahan subarachnoid","B":"Spondylosis servikal berat","C":"Meningitis","D":"Carpal Tunnel Syndrome","E":"Parkinsonism"},"answer":"D","explanation":"Kaku kuduk positif dapat ditemukan pada meningitis, perdarahan subarachnoid, spondylosis servikal berat, dan parkinsonism. Carpal Tunnel Syndrome adalah kondisi jepitan nervus medianus di pergelangan tangan, tidak berkaitan dengan kaku kuduk.","explanationImages":[],"isBroken":false},{"id":"Q35","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Brudzinski Cheek Sign dikatakan positif bila:","questionImages":[],"options":{"A":"Penekanan simfisis pubis menimbulkan abduksi tungkai","B":"Fleksi pasif satu tungkai diikuti fleksi tungkai kontralateral","C":"Penekanan pada kedua pipi (inferior arkus zigomatikus) menimbulkan fleksi spontan lengan atas dan bawah","D":"Fleksi leher menimbulkan fleksi pinggul dan lutut","E":"Ekstensi lutut menimbulkan nyeri hebat"},"answer":"C","explanation":"Cheek Sign positif jika pemberian tekanan pada kedua pipi (di inferior arkus zigomatikus) menimbulkan fleksi spontan pada lengan atas dan bawah.","explanationImages":[],"isBroken":false},{"id":"Q36","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Brudzinski Symphyseal Sign diperiksa dengan cara menekan pada:","questionImages":[],"options":{"A":"Simfisis pubis","B":"Kedua pipi","C":"Belakang kepala","D":"Dorsum pedis","E":"Tendo achilles"},"answer":"A","explanation":"Pemeriksaan dilakukan dengan menekan pada simfisis pubis. Tanda ini positif bila terjadi refleks berupa fleksi pinggul dan lutut serta abduksi tungkai.","explanationImages":[],"isBroken":false},{"id":"Q37","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Brudzinski Contralateral Leg Sign dikatakan positif apabila:","questionImages":[],"options":{"A":"Fleksi pasif salah satu tungkai bawah (lutut ekstensi) diikuti refleks fleksi pinggul dan lutut pada tungkai kontralateral","B":"Ekstensi lutut menimbulkan fleksi pipi","C":"Fleksi leher menimbulkan nyeri punggung","D":"Rotasi kepala menimbulkan nyeri bahu","E":"Penekanan simfisis menimbulkan fleksi leher"},"answer":"A","explanation":"Dilakukan fleksi pasif pada salah satu sisi ekstremitas bawah dengan lutut dalam kondisi ekstensi; bila diikuti refleks fleksi di pinggul dan lutut pada ekstremitas kontralateral, tanda ini positif.","explanationImages":[],"isBroken":false},{"id":"Q38","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Prosedur Brudzinski Neck Sign paling mirip dengan pemeriksaan:","questionImages":[],"options":{"A":"Tes Phalen","B":"Refleks Hoffmann","C":"Tes Tinel","D":"Kaku kuduk","E":"Refleks Babinski"},"answer":"D","explanation":"Prosedur Brudzinski Neck Sign sama dengan penilaian kaku kuduk (fleksi pasif leher pasien), namun yang dinilai sebagai tanda positif adalah munculnya fleksi pada pinggul dan lutut sebagai respons.","explanationImages":[],"isBroken":false},{"id":"Q39","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pada gambar berikut, tangan kiri pemeriksa berada di belakang kepala pasien dan tangan kanan pada dada pasien untuk mencegah pasien bangun saat leher difleksikan secara pasif. Ini adalah pemeriksaan: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-013.png"],"options":{"A":"Brudzinski Neck Sign","B":"Kernig's Sign","C":"Lasegue Sign","D":"Tes Nafziger","E":"Tes Distraksi"},"answer":"A","explanation":"Posisi tangan pemeriksa di belakang kepala dan di dada pasien saat fleksi leher pasif adalah ciri khas pemeriksaan Brudzinski Neck Sign.","explanationImages":[],"isBroken":false},{"id":"Q40","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Kernig's Sign dinilai positif apabila:","questionImages":[],"options":{"A":"Kepala tidak dapat digerakkan sama sekali","B":"Ibu jari kaki berekstensi","C":"Timbul fleksi involunter lutut, atau lutut tidak dapat diekstensikan melebihi 135 derajat saat pinggul dalam kondisi fleksi","D":"Lutut dapat diekstensikan penuh tanpa nyeri saat pinggul fleksi","E":"Timbul nyeri pada pergelangan tangan"},"answer":"C","explanation":"Tanda Kernig positif berupa fleksi involunter pada lutut ketika pemeriksa mencoba mengekstensikan lutut dengan pinggul dalam kondisi fleksi, atau bila pasien tidak mampu mengekstensikan lutut melebihi 135 derajat.","explanationImages":[],"isBroken":false},{"id":"Q41","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Kernig's Sign yang positif BILATERAL paling mengarah pada:","questionImages":[],"options":{"A":"Cedera pergelangan tangan","B":"Carpal Tunnel Syndrome","C":"Radikulopati unilateral","D":"Kelainan sendi sakroiliaka","E":"Iritasi meningeal"},"answer":"E","explanation":"Kernig sign positif bilateral menandakan iritasi meningeal, sedangkan bila hanya unilateral perlu dicurigai radikulopati dan dilanjutkan dengan pemeriksaan straight leg raising.","explanationImages":[],"isBroken":false},{"id":"Q42","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Gambar berikut menunjukkan pemeriksa memfleksikan pinggul dan lutut pasien, lalu mencoba mengekstensikan lutut secara pasif. Pemeriksaan ini adalah: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-014.png"],"options":{"A":"Nafziger Sign","B":"Patrick Sign","C":"Tinel Sign","D":"Lasegue Sign","E":"Kernig's Sign"},"answer":"E","explanation":"Fleksi pinggul dan lutut diikuti upaya ekstensi lutut secara pasif adalah teknik khas pemeriksaan Kernig's Sign.","explanationImages":[],"isBroken":false},{"id":"Q43","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tanda Chvostek diperiksa dengan cara:","questionImages":[],"options":{"A":"Menekan vena jugularis","B":"Menekan simfisis pubis","C":"Menggores telapak kaki","D":"Mengangkat kepala pasien","E":"Mengetuk saraf facialis di bawah processus zygomaticus, di depan telinga"},"answer":"E","explanation":"Pemeriksaan dilakukan dengan mengetuk pada saraf facialis di bagian bawah processus zygomaticus, di depan telinga.","explanationImages":[],"isBroken":false},{"id":"Q44","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tanda Chvostek berkaitan erat dengan hipereksitabilitas saraf motorik yang klasik ditemukan pada:","questionImages":[],"options":{"A":"Carpal Tunnel Syndrome","B":"Tetanus (spasme karpopedal)","C":"Osteoartritis","D":"Sciatica","E":"Migrain"},"answer":"B","explanation":"Manifestasi klinis pada tetanus termasuk spasme dan kontraksi tonik otot rangka, termasuk spasme karpopedal, akibat hipereksitabilitas saraf motorik terhadap stimulus mekanik — inilah dasar munculnya tanda Chvostek.","explanationImages":[],"isBroken":false},{"id":"Q45","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tanda Chvostek juga dapat ditemukan secara fisiologis pada:","questionImages":[],"options":{"A":"Pasien lanjut usia dengan osteoporosis","B":"Pasien dengan riwayat stroke","C":"Mayoritas neonatus, dan menghilang seiring bertambahnya usia anak","D":"Seluruh orang dewasa sehat","E":"Ibu hamil trimester ketiga"},"answer":"C","explanation":"Tanda Chvostek dapat muncul pada kondisi hiperrefleks (misalnya lesi traktus kortikospinalis) maupun secara fisiologis pada mayoritas neonatus, dan menghilang saat beranjak usia anak-anak.","explanationImages":[],"isBroken":false},{"id":"Q46","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Leg Raising Test terdiri dari dua macam, yaitu:","questionImages":[],"options":{"A":"Babinski test dan Chaddock test","B":"Tinel test dan Phalen test","C":"Valsava test dan Nafziger test","D":"VAS dan NRS","E":"Bent-knee leg-raising test (Kernig's sign) dan straight-knee leg-raising test (Lasegue's sign)"},"answer":"E","explanation":"Penilaian kompresi akar saraf dengan straight leg raising terdiri dari dua macam: bent-knee leg-raising test (Kernig's sign) dan straight-knee leg-raising test (Lasegue's sign).","explanationImages":[],"isBroken":false},{"id":"Q47","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pada pemeriksaan tanda Lasegue, secara normal paha pasien dapat dielevasi (fleksi pinggul dengan lutut lurus) hingga:","questionImages":[],"options":{"A":"135 derajat","B":"60 derajat","C":"45 derajat","D":"30 derajat","E":"90 derajat"},"answer":"E","explanation":"Normalnya, paha dapat dielevasi hingga 90 derajat. Pasien dengan kompresi akar saraf akan mengernyit nyeri dan memfleksikan lutut pada jarak kurang dari 90 derajat.","explanationImages":[],"isBroken":false},{"id":"Q48","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pemeriksa mengangkat tumit/betis pasien dengan lutut tetap lurus untuk memfleksikan pinggul, seperti gambar berikut. Ini adalah teknik pemeriksaan: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-015.png"],"options":{"A":"Lasegue Sign (straight leg raising)","B":"Kernig's Sign","C":"Kaku kuduk","D":"Tromner Sign","E":"Patrick Sign"},"answer":"A","explanation":"Mengangkat tumit/betis dengan lutut tetap lurus (straight-knee) untuk memfleksikan pinggul adalah ciri khas tanda Lasegue.","explanationImages":[],"isBroken":false},{"id":"Q49","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Fajersztajn's crossed straight leg-raising sign bersifat patognomonis untuk:","questionImages":[],"options":{"A":"Meningitis","B":"Herniasi diskus","C":"Tetanus","D":"Spondylosis servikal","E":"Carpal Tunnel Syndrome"},"answer":"B","explanation":"Fajersztajn's crossed straight leg-raising sign — nyeri pada tungkai yang sehat ketika tungkai kontralateral dielevasi — bersifat patognomonis pada herniasi diskus.","explanationImages":[],"isBroken":false},{"id":"Q50","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Akronim FABER pada tes Patrick merujuk pada gerakan:","questionImages":[],"options":{"A":"Fleksi, Abduksi, External Rotasi","B":"Ekstensi, Abduksi, External Rotasi","C":"Fleksi, Abduksi, Elevasi, Rotasi","D":"Fleksi, Abduksi, Internal Rotasi","E":"Fleksi, Adduksi, External Rotasi"},"answer":"A","explanation":"FABER merupakan akronim dari Fleksi, Abduksi, dan External Rotasi — gerakan tersinkronisasi yang timbul pada pinggul ipsilateral saat tes Patrick dilakukan.","explanationImages":[],"isBroken":false},{"id":"Q51","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pada gambar berikut, tumit/engkel lateral tungkai yang sakit diletakkan di atas lutut kontralateral, lalu sisi medial lutut ditekan ke bawah. Nyeri pada area inguinal pada tes ini mengindikasikan kelainan pada: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-016.png"],"options":{"A":"Sendi sakroiliaka","B":"Tendo achilles","C":"Sendi pergelangan kaki","D":"Sendi pinggul","E":"Sendi lutut"},"answer":"D","explanation":"Jika nyeri timbul pada area inguinal saat tes FABER/Patrick, hal ini merujuk pada adanya kelainan pada sendi pinggul. Nyeri di area sakroiliaka merujuk pada kelainan sendi sakroiliaka.","explanationImages":[],"isBroken":false},{"id":"Q52","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pada pemeriksaan Kontra Patrick, tungkai pasien yang sakit dilakukan gerakan:","questionImages":[],"options":{"A":"Fleksi, endorotasi, dan adduksi","B":"Ekstensi, endorotasi, dan adduksi","C":"Ekstensi, eksorotasi, dan abduksi","D":"Hiperekstensi tanpa rotasi","E":"Fleksi, eksorotasi, dan abduksi"},"answer":"A","explanation":"Pada Kontra Patrick, pemeriksa melipat (fleksi) tungkai pasien yang sakit lalu meng-endorotasikan serta meng-adduksikannya. Nyeri pada garis sendi sakroiliaka menunjukkan hasil positif.","explanationImages":[],"isBroken":false},{"id":"Q53","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Pada skala Visual Analogue Scale (VAS), pasien diminta menunjuk titik sepanjang garis 0-10, di mana angka 0 merepresentasikan:","questionImages":[],"options":{"A":"Bebas nyeri","B":"Nyeri paling ringan yang masih terasa","C":"Nyeri kronik","D":"Nyeri tidak tertahankan","E":"Nyeri sedang"},"answer":"A","explanation":"Pada VAS, pasien membayangkan angka 0 sebagai representasi bebas nyeri, dan nilai 10 sebagai nyeri yang tidak tertahankan.","explanationImages":[],"isBroken":false},{"id":"Q54","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Numerical Rating Scale (NRS) dan VAS memiliki kesamaan dalam hal:","questionImages":[],"options":{"A":"Keduanya menggunakan gambar ekspresi wajah","B":"Keduanya menilai refleks patologis","C":"Keduanya memerlukan palu refleks","D":"Keduanya menggunakan rentang angka 0-10 untuk menilai intensitas nyeri","E":"Keduanya hanya untuk pasien anak"},"answer":"D","explanation":"NRS menggunakan rentang angka 0-10 (0 = tidak ada nyeri, 10 = nyeri terburuk yang dapat dibayangkan), serupa dengan prinsip skala numerik pada VAS.","explanationImages":[],"isBroken":false},{"id":"Q55","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Faces Rating Scale (FRS) menggunakan rangkaian enam ekspresi wajah (Wong-Baker Faces Scale) dan paling tepat digunakan pada:","questionImages":[],"options":{"A":"Pasien koma","B":"Pasien dengan refleks Babinski negatif","C":"Pasien dengan Carpal Tunnel Syndrome","D":"Pasien dengan kaku kuduk positif","E":"Pasien anak atau pasien yang kesulitan mengekspresikan nyeri secara numerik"},"answer":"E","explanation":"FRS menggunakan enam ekspresi wajah dari tersenyum hingga menangis, digunakan terutama pada pasien anak atau pasien yang kesulitan mengekspresikan intensitas nyerinya secara numerik.","explanationImages":[],"isBroken":false},{"id":"Q56","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tes Kompresi (Tes Lhermitte) dilakukan untuk mengevaluasi:","questionImages":[],"options":{"A":"Iritasi meningeal","B":"Kekuatan otot bisep","C":"Nyeri akibat kompresi radiks servikal, dengan menekan kepala pasien pada berbagai posisi","D":"Kompresi radiks lumbal dengan straight leg raising","E":"Kompresi karpal pada CTS"},"answer":"C","explanation":"Bila terdapat nyeri saraf akibat kompresi radiks servikal, kompresi pada kepala pasien (dalam berbagai posisi) akan menimbulkan atau memperhebat nyeri radikuler yang sesuai.","explanationImages":[],"isBroken":false},{"id":"Q57","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Gambar berikut menunjukkan pemeriksa melakukan kompresi pada kepala pasien dalam berbagai posisi (miring kanan-kiri, tengadah-menunduk). Tes ini disebut: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-017.png"],"options":{"A":"Tes Tinel","B":"Tes Valsava","C":"Tes Distraksi","D":"Tes Kompresi / Tes Lhermitte","E":"Tes Nafziger"},"answer":"D","explanation":"Kompresi pada kepala pasien dalam berbagai posisi untuk membangkitkan nyeri radikuler servikal adalah ciri khas Tes Kompresi (Tes Lhermitte).","explanationImages":[],"isBroken":false},{"id":"Q58","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Prinsip Tes Distraksi berlawanan dengan Tes Kompresi, yaitu:","questionImages":[],"options":{"A":"Menekan kepala pasien untuk memperberat nyeri","B":"Meregangkan nervus skiatika","C":"Menekan vena jugularis","D":"Mengangkat kepala pasien sehingga kompresi radiks servikal berkurang dan nyeri saraf berkurang/hilang","E":"Meminta pasien mengejan"},"answer":"D","explanation":"Dengan mengangkat kepala pasien, kompresi pada radiks servikal dapat dikurangi, sehingga nyeri saraf juga berkurang atau lenyap — berlawanan prinsip dengan Tes Kompresi.","explanationImages":[],"isBroken":false},{"id":"Q59","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tes Valsava dilakukan dengan cara:","questionImages":[],"options":{"A":"Menggores telapak kaki","B":"Menekan kedua vena jugularis pasien","C":"Mengetuk saraf facialis","D":"Mengangkat kepala pasien","E":"Meminta pasien mengejan sambil menahan napas untuk meningkatkan tekanan intratekal"},"answer":"E","explanation":"Tekanan intratekal ditingkatkan dengan meminta pasien mengejan pada saat pasien menahan napas. Bila terdapat proses desak ruang di kanalis vertebralis, hal ini akan membangkitkan nyeri radikuler.","explanationImages":[],"isBroken":false},{"id":"Q60","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tes pada gambar berikut meningkatkan tekanan intratekal sehingga dapat membangkitkan nyeri radikuler bila terdapat proses desak ruang di kanalis vertebralis. Tes ini adalah: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-018.png"],"options":{"A":"Tes Nafziger","B":"Tes Tinel","C":"Tes Valsava","D":"Tes Phalen","E":"Tes Distraksi"},"answer":"C","explanation":"Peningkatan tekanan intratekal melalui manuver mengejan sambil menahan napas adalah ciri khas Tes Valsava.","explanationImages":[],"isBroken":false},{"id":"Q61","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Perbedaan Tes Nafziger dengan Tes Valsava terletak pada:","questionImages":[],"options":{"A":"Tidak ada perbedaan, keduanya identik","B":"Tes Nafziger menilai refleks patologis ekstremitas bawah","C":"Tes Nafziger hanya bisa dilakukan pada posisi berbaring","D":"Tes Nafziger menggunakan palu refleks","E":"Tes Nafziger dilakukan dengan menekan kedua vena jugularis sambil pasien mengejan, sedangkan Valsava cukup dengan mengejan menahan napas tanpa penekanan vena jugularis"},"answer":"E","explanation":"Tes Nafziger juga ditujukan untuk meningkatkan tekanan intratekal, namun dilakukan dengan meminta pasien mengejan saat kedua vena jugularis ditekan oleh kedua tangan pemeriksa, dan dapat dilakukan pada posisi berdiri maupun berbaring.","explanationImages":[],"isBroken":false},{"id":"Q62","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tes Tinel dilakukan dengan cara:","questionImages":[],"options":{"A":"Menekuk kedua pergelangan tangan dan menekankan dorsum manus satu sama lain","B":"Menekan/mengetuk pada ligamentum volare pergelangan tangan","C":"Menggores telapak kaki","D":"Menekan simfisis pubis","E":"Mengetuk tendo achilles"},"answer":"B","explanation":"Tes Tinel dilakukan dengan penekanan atau pengetukan pada ligamentum volare pergelangan tangan. Tes positif bila muncul nyeri atau parestesia di kawasan nervus medianus, mengarah pada Carpal Tunnel Syndrome.","explanationImages":[],"isBroken":false},{"id":"Q63","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Penekanan/pengetukan pada ligamentum volare pergelangan tangan seperti gambar berikut, dengan hasil positif berupa nyeri/parestesia pada kawasan nervus medianus, merupakan pemeriksaan: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-019.png"],"options":{"A":"Refleks Hoffmann","B":"Tes Nafziger","C":"Tes Distraksi","D":"Tes Phalen","E":"Tes Tinel"},"answer":"E","explanation":"Penekanan/pengetukan pada ligamentum volare pergelangan tangan adalah ciri khas Tes Tinel.","explanationImages":[],"isBroken":false},{"id":"Q64","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Tes Phalen dilakukan dengan cara:","questionImages":[],"options":{"A":"Menyentil ujung jari tengah","B":"Menekuk kedua pergelangan tangan lalu menekankan kedua dorsum manus satu dengan yang lain sekuat-kuatnya","C":"Menggores ujung kuku jari tengah","D":"Menekan simfisis pubis","E":"Mengetuk ligamentum volare"},"answer":"B","explanation":"Tes Phalen memiliki tujuan yang sama dengan Tes Tinel (mendeteksi Carpal Tunnel Syndrome), namun teknik pelaksanaannya berbeda: kedua pergelangan tangan ditekuk lalu kedua dorsum manus ditekankan satu sama lain sekuat-kuatnya.","explanationImages":[],"isBroken":false},{"id":"Q65","category":"Kuis Pemeriksaan Refleks Patologis & Tanda Neurologis Lain","question":"Gambar berikut menunjukkan pasien menekuk kedua pergelangan tangan dan menekankan dorsum manus satu sama lain. Bila timbul nyeri dan parestesia di kawasan nervus medianus, tes ini disebut tes: ","questionImages":["images/packages/latihan-kk7__latihan-pemeriksaan-tanda-meningeal-v2/img-020.png"],"options":{"A":"Phalen","B":"Nafziger","C":"Valsava","D":"Distraksi","E":"Tinel"},"answer":"A","explanation":"Menekuk kedua pergelangan tangan dan menekankan dorsum manus satu sama lain adalah ciri khas Tes Phalen.","explanationImages":[],"isBroken":false}]}
