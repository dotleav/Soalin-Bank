@@ -0,0 +1 @@
+{"id":"2h-pk-lcs-cairan-otak__latihan-responsi-analisis-lcs-v2","title":"Latihan Responsi Analisis LCS V2","category":"2H PK - LCS Cairan Otak","questions":[{"id":"Q1","category":"","question":"Cairan liquor cerebrospinalis (LCS) diproduksi terutama oleh struktur berikut:","questionImages":[],"options":{"A":"Sel-sel pada dura mater","B":"Vena-vena pada sinus sagitalis","C":"Sel glia pada substansia grisea","D":"Kapiler pada arakhnoid mater","E":"Pleksus koroideus pada pia mater"},"answer":"E","explanation":"LCS diproduksi terutama oleh sekresi pleksus koroideus yang berada di pia mater, ditambah produksi minor dari sel ependimal.","explanationImages":[],"isBroken":false},{"id":"Q2","category":"","question":"Aliran LCS pada sistem saraf pusat berada pada ruang yang disebut spasium subarakhnoid, yaitu ruang di antara dua lapisan meninges berikut:","questionImages":[],"options":{"A":"Pia mater dan periosteum kranium","B":"Arakhnoid mater dan periosteum kranium","C":"Dura mater dan arakhnoid mater","D":"Dura mater dan pia mater","E":"Arakhnoid mater dan pia mater"},"answer":"A","explanation":"Spasium subarakhnoid terletak di antara lapisan arakhnoid mater dan pia mater, tempat LCS mengalir dan membasahi jaringan sistem saraf pusat.","explanationImages":[],"isBroken":false},{"id":"Q3","category":"","question":"Proses pembentukan dan reabsorpsi LCS berjalan secara dinamis dengan laju sekitar:","questionImages":[],"options":{"A":"200 mL per jam","B":"5 mL per jam","C":"2 mL per jam","D":"20 mL per jam","E":"50 mL per jam"},"answer":"B","explanation":"LCS terbentuk, bersirkulasi, dan direabsorpsi ke darah secara dinamis dengan laju kurang lebih 20 mL per jam.","explanationImages":[],"isBroken":false},{"id":"Q4","category":"","question":"Volume total LCS pada kondisi fisiologis orang dewasa berkisar pada rentang:","questionImages":[],"options":{"A":"5–20 mL","B":"85–150 mL","C":"200–350 mL","D":"10–60 mL","E":"400–600 mL"},"answer":"D","explanation":"Pada dewasa, volume LCS fisiologis berkisar 85–150 mL, sedangkan pada neonatus jauh lebih kecil yaitu 10–60 mL.","explanationImages":[],"isBroken":false},{"id":"Q5","category":"","question":"Pengambilan sampel LCS melalui pungsi lumbal pada pasien dewasa idealnya dilakukan pada spasium:","questionImages":[],"options":{"A":"L3-4 atau L2-3","B":"L1-2 atau T12-L1","C":"L4-5 atau L5-S1","D":"T11-12 atau T12-L1","E":"L5-S1 atau S1-S2"},"answer":"E","explanation":"Pungsi lumbal pada dewasa dilakukan pada spasium L3-4 atau L2-3, sedangkan pada anak dilakukan pada L4-5 agar aman dari struktur medula spinalis.","explanationImages":[],"isBroken":false},{"id":"Q6","category":"","question":"Sampel LCS hasil pungsi lumbal ditampung dalam tiga tabung steril. Tabung kedua digunakan untuk pemeriksaan:","questionImages":[],"options":{"A":"Kimiawi dan imunologis","B":"Mikroskopis komponen seluler","C":"Sitologi keganasan","D":"Mikrobiologis","E":"Serologis virus"},"answer":"D","explanation":"Tabung pertama untuk pemeriksaan kimiawi dan imunologi, tabung kedua untuk pemeriksaan mikrobiologis, dan tabung ketiga untuk pemeriksaan mikroskopis (komponen seluler).","explanationImages":[],"isBroken":false},{"id":"Q7","category":"","question":"Cara membedakan darah pada LCS akibat traumatic tap dengan perdarahan subarakhnoid sebelumnya adalah dengan menilai:","questionImages":[],"options":{"A":"Perubahan warna dari tabung 1 ke tabung 3 saat pengambilan","B":"Jumlah leukosit pada tabung pertama","C":"Nilai pH pada tabung pertama","D":"Kadar protein pada tabung kedua","E":"Kadar glukosa pada tabung ketiga"},"answer":"B","explanation":"Jika warna darah semakin minim/jernih dari tabung 1 ke tabung 3, darah berasal dari traumatic tap. Pada perdarahan subarakhnoid, darah tetap tampak pada seluruh tabung.","explanationImages":[],"isBroken":false},{"id":"Q8","category":"","question":"Setelah disentrifus, supernatan LCS pada perdarahan subarakhnoid (bukan traumatic tap) umumnya berwarna:","questionImages":[],"options":{"A":"Coklat kehitaman","B":"Hijau kebiruan","C":"Putih susu keruh","D":"Merah muda hingga kuning atau oranye","E":"Jernih seperti aquades"},"answer":"A","explanation":"Pada perdarahan subarakhnoid, eritrosit yang lisis melepaskan hemoglobin sehingga supernatan setelah sentrifugasi berwarna merah muda hingga kuning atau oranye.","explanationImages":[],"isBroken":false},{"id":"Q9","category":"","question":"Pemeriksaan LCS harus segera dilakukan setelah sampel diambil karena penundaan dapat menyebabkan:","questionImages":[],"options":{"A":"Penurunan palsu jumlah sel dan peningkatan palsu kadar laktat","B":"Peningkatan palsu jumlah sel dan penurunan palsu kadar protein","C":"Peningkatan palsu kadar BUN dan penurunan palsu osmolaritas","D":"Peningkatan palsu kadar glukosa dan penurunan palsu pH","E":"Penurunan palsu kadar natrium dan peningkatan palsu kalium"},"answer":"B","explanation":"Penundaan pemeriksaan menyebabkan lisis sel (jumlah sel terhitung menjadi palsu rendah) dan glikolisis oleh sel yang masih hidup (kadar laktat menjadi palsu tinggi).","explanationImages":[],"isBroken":false},{"id":"Q10","category":"","question":"Pada pemeriksaan makroskopis LCS, warna hijau paling khas dikaitkan dengan kondisi:","questionImages":[],"options":{"A":"Traumatic tap dan ingesti karotenoid","B":"Meningeal melanomatosis","C":"Peningkatan protein tanpa infeksi","D":"Kadar glukosa yang sangat rendah","E":"Hiperbilirubinemia dan proses purulen"},"answer":"C","explanation":"Warna hijau pada LCS terutama dikaitkan dengan hiperbilirubinemia dan proses purulen (bernanah).","explanationImages":[],"isBroken":false},{"id":"Q11","category":"","question":"Warna cokelat pada cairan LCS saat pemeriksaan makroskopis paling khas menunjukkan kondisi:","questionImages":[],"options":{"A":"Peningkatan albumin serum","B":"Traumatic tap akut","C":"Ingesti karotenoid berlebihan","D":"Meningeal melanomatosis","E":"Hyperbilirubinemia ringan"},"answer":"D","explanation":"Warna cokelat pada LCS merupakan tanda khas meningeal melanomatosis, berbeda dari warna kuning/oranye/pink yang lebih sering dikaitkan dengan darah atau bilirubin.","explanationImages":[],"isBroken":false},{"id":"Q12","category":"","question":"Pada penilaian kejernihan LCS secara makroskopis, derajat kekeruhan nyata dilaporkan dengan kode:","questionImages":[],"options":{"A":"1+","B":"4+","C":"2+","D":"0","E":"3+"},"answer":"A","explanation":"Skala kejernihan LCS: 0 = jernih, 1+ = berkabut, 2+ = kekeruhan ringan, 3+ = kekeruhan nyata, dan 4+ = sangat keruh.","explanationImages":[],"isBroken":false},{"id":"Q13","category":"","question":"Reagen yang digunakan untuk mengencerkan dan mewarnai sel sebelum penghitungan jumlah sel LCS secara manual pada bilik hitung adalah:","questionImages":[],"options":{"A":"Reagen Nonne","B":"Reagen Pandy","C":"Ammonium sulfat jenuh","D":"Larutan Turk","E":"Larutan fenol jenuh"},"answer":"C","explanation":"Larutan Turk digunakan untuk mengencerkan sekaligus melisiskan eritrosit agar leukosit lebih mudah dihitung pada bilik hitung.","explanationImages":[],"isBroken":false},{"id":"Q14","category":"","question":"Nilai normal jumlah sel LCS pada orang dewasa menurut acuan pemeriksaan mikroskopis adalah:","questionImages":[],"options":{"A":"10–50 sel/µL","B":"0–5 sel/µL","C":"20–100 sel/µL","D":"5–20 sel/µL","E":"0–30 sel/µL"},"answer":"E","explanation":"Nilai normal jumlah sel LCS adalah 0–5 sel/µL pada dewasa, sedangkan pada neonatus nilai normalnya lebih tinggi yaitu 0–30 sel/µL.","explanationImages":[],"isBroken":false},{"id":"Q15","category":"","question":"Prinsip pemeriksaan Pandy pada analisis LCS adalah mendeteksi keberadaan:","questionImages":[],"options":{"A":"Natrium dan kalium","B":"Glukosa dan laktat","C":"Bilirubin dan urobilin","D":"Kreatinin dan ureum","E":"Albumin dan globulin"},"answer":"C","explanation":"Pemeriksaan Pandy merupakan uji kualitatif menggunakan reagen fenol jenuh untuk mendeteksi albumin dan globulin dalam LCS.","explanationImages":[],"isBroken":false},{"id":"Q16","category":"","question":"Hasil pemeriksaan Pandy dinyatakan positif apabila setelah penambahan LCS ke reagen Pandy terlihat:","questionImages":[],"options":{"A":"Kekeruhan yang jelas","B":"Cincin putih di permukaan","C":"Endapan berwarna cokelat","D":"Perubahan pH yang tajam","E":"Warna kuning kehijauan"},"answer":"A","explanation":"Pemeriksaan Pandy dinyatakan positif bila terlihat kekeruhan yang jelas setelah penambahan LCS ke dalam reagen Pandy (fenol jenuh).","explanationImages":[],"isBroken":false},{"id":"Q17","category":"","question":"Pemeriksaan Nonne-Apelt pada analisis LCS bertujuan mendeteksi keberadaan:","questionImages":[],"options":{"A":"Albumin","B":"Laktat","C":"Bilirubin","D":"Globulin","E":"Glukosa"},"answer":"E","explanation":"Pemeriksaan Nonne-Apelt menggunakan reagen ammonium sulfat jenuh untuk mendeteksi globulin pada LCS.","explanationImages":[],"isBroken":false},{"id":"Q18","category":"","question":"Hasil pemeriksaan Nonne-Apelt dikatakan negatif apabila:","questionImages":[],"options":{"A":"Tidak terbentuk cincin di antara kedua lapisan","B":"Terbentuk endapan setelah didiamkan 3 menit","C":"Terbentuk cincin putih abu-abu yang menghilang setelah dikocok","D":"Terjadi opalesensi setelah dikocok","E":"Cairan mengawan setelah dikocok"},"answer":"B","explanation":"Hasil Nonne-Apelt dinyatakan negatif bila tidak terbentuk cincin putih abu-abu di antara dua lapisan reagen Nonne dan LCS.","explanationImages":[],"isBroken":false},{"id":"Q19","category":"","question":"Rasio albumin terhadap globulin pada LCS normal, dibandingkan dengan plasma darah, adalah:","questionImages":[],"options":{"A":"4:1, hampir sama dengan plasma","B":"8:1, sekitar 3–4 kali lebih tinggi dari plasma","C":"8:1, sekitar 3–4 kali lebih rendah dari plasma","D":"1:4, sedikit lebih rendah dari plasma","E":"1:8, sekitar 2 kali lebih tinggi dari plasma"},"answer":"C","explanation":"Rasio albumin/globulin pada LCS normal adalah 8:1, yaitu sekitar 3–4 kali lebih tinggi dibandingkan rasio pada plasma.","explanationImages":[],"isBroken":false},{"id":"Q20","category":"","question":"Diferensial sel pada LCS normal didominasi oleh sel jenis:","questionImages":[],"options":{"A":"Sel blast","B":"Eosinofil","C":"Mononuklear (limfosit dan monosit)","D":"Sel plasma","E":"Polimorfonuklear (neutrofil)"},"answer":"D","explanation":"LCS normal memiliki diferensial sel yang didominasi sel mononuklear, terdiri dari sekitar 70% limfosit dan 30% monosit.","explanationImages":[],"isBroken":false},{"id":"Q21","category":"","question":"Pada meningitis bakterial, gambaran diferensial sel LCS yang khas ditemukan adalah dominasi sel:","questionImages":[],"options":{"A":"Polimorfonuklear (PMN)","B":"Sel plasma","C":"Mononuklear (limfosit)","D":"Monosit murni","E":"Eosinofil"},"answer":"A","explanation":"Meningitis bakterial khas menunjukkan dominasi sel polimorfonuklear (PMN) pada diferensial sel LCS, berbeda dengan meningitis viral, fungal, dan TBC yang predominan mononuklear.","explanationImages":[],"isBroken":false},{"id":"Q22","category":"","question":"Pada meningitis viral, jumlah sel LCS dan tekanan pembukaan (opening pressure) yang umum ditemukan adalah:","questionImages":[],"options":{"A":"Jumlah sel lebih dari 1000/mm³ dengan opening pressure selalu meningkat tajam","B":"Jumlah sel kurang dari 100/mm³ dengan opening pressure biasanya normal","C":"Jumlah sel normal dengan opening pressure selalu menurun","D":"Jumlah sel nol dengan opening pressure tidak dapat diukur","E":"Jumlah sel bervariasi luas dengan opening pressure selalu sangat tinggi"},"answer":"C","explanation":"Meningitis viral khas menunjukkan jumlah sel LCS kurang dari 100/mm³ dengan diferensial predominan mononuklear (limfosit), dan opening pressure yang biasanya normal.","explanationImages":[],"isBroken":false},{"id":"Q23","category":"","question":"Meningitis fungal dan meningitis TBC memiliki kesamaan gambaran diferensial sel LCS berupa predominasi sel:","questionImages":[],"options":{"A":"Polimorfonuklear (neutrofil)","B":"Sel plasma","C":"Eosinofil","D":"Basofil","E":"Mononuklear (limfosit)"},"answer":"B","explanation":"Meningitis fungal dan meningitis TBC sama-sama menunjukkan predominasi sel mononuklear (limfosit) pada diferensial sel LCS, mirip dengan meningitis viral namun berbeda dari meningitis bakterial.","explanationImages":[],"isBroken":false}]}
