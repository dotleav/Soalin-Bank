+{"id":"2h-persiapan-minites__infeksi-sistem-saraf","title":"Infeksi Sistem Saraf","category":"2H - Persiapan Minites 1","questions":[{"id":"Q1","category":"","question":"Infeksi yang mengenai selaput otak (menings) disebut...","questionImages":[],"options":{"A":"Meningitis","B":"Mielitis","C":"Ensefalitis","D":"Abses serebri","E":"Meningoensefalitis"},"answer":"A","explanation":"Meningitis = infeksi menings; ensefalitis = infeksi ensefalon; meningoensefalitis = keduanya.","explanationImages":[],"isBroken":false},{"id":"Q2","category":"","question":"Abses serebri pada spektrum infeksi SSP merupakan...","questionImages":[],"options":{"A":"Infeksi terbatas pada menings tanpa keterlibatan parenkim otak","B":"Peradangan menings akibat reaksi autoimun terhadap mielin","C":"Infeksi ensefalon akibat virus tanpa pembentukan pus lokal","D":"Infeksi medula spinalis yang menyebar naik ke menings","E":"Tahap lanjut meningitis yang membentuk abses di dalam ensefalon"},"answer":"E","explanation":"Abses serebri adalah tahap lanjut meningitis dengan pembentukan abses dalam ensefalon.","explanationImages":[],"isBroken":false},{"id":"Q3","category":"","question":"Port d'entry dan fokus infeksi yang dapat mendahului infeksi SSP menurut patogenesis ME adalah...","questionImages":[],"options":{"A":"Hanya infeksi saluran kemih dan saluran cerna","B":"ISPA, ISK, infeksi THT, dan trauma kepala","C":"Hanya infeksi telinga, hidung, dan tenggorok","D":"Gangguan metabolik dan defisiensi nutrisi kronik","E":"Hanya trauma kepala tanpa fokus infeksi lain"},"answer":"B","explanation":"Mikroorganisme masuk lewat mukosa/kulit, dapat dari ISPA, ISK, infeksi THT, trauma kepala, lalu septikemia dan menembus sawar otak.","explanationImages":[],"isBroken":false},{"id":"Q4","category":"","question":"Manakah pasangan mikroorganisme dan golongannya yang benar sebagai etiologi ME?","questionImages":[],"options":{"A":"Angiostrongylus – bakteri","B":"Cysticercus – virus","C":"Cryptococcus neoformans – protozoa","D":"Naegleria – jamur","E":"Toxoplasma gondii – protozoa"},"answer":"E","explanation":"Protozoa: Toxoplasma, Treponema (sesuai slide), Naegleria, Leptospira; jamur: Cryptococcus; cacing: Cysticercus, Angiostrongylus.","explanationImages":[],"isBroken":false},{"id":"Q5","category":"","question":"Penyebab utama meningitis bakterial pada usia 2–18 tahun berdasarkan grafik Schuchat adalah...","questionImages":[],"options":{"A":"Streptococcus grup B dan Listeria monocytogenes","B":"Streptococcus grup B dan Escherichia coli","C":"Listeria monocytogenes dan Haemophilus influenzae","D":"Neisseria meningitidis dan Streptococcus pneumoniae","E":"Haemophilus influenzae saja pada semua usia"},"answer":"D","explanation":"Pada usia anak-remaja, N. meningitidis dan S. pneumoniae dominan; grup B Strep dan Listeria dominan pada neonatus dan usia lanjut.","explanationImages":[],"isBroken":false},{"id":"Q6","category":"","question":"Penyebab paling umum meningitis viral (80–85%) dan cara transmisinya adalah...","questionImages":[],"options":{"A":"HSV, melalui kontak seksual","B":"Virus mumps, melalui droplet","C":"Arbovirus, melalui gigitan vektor","D":"Lymphocytic choriomeningitis virus, melalui urin hewan pengerat","E":"Enterovirus (coxsackie), fekal-oral"},"answer":"E","explanation":"Enterovirus/coxsackievirus penyebab tersering meningitis viral, transmisi fekal-oral.","explanationImages":[],"isBroken":false},{"id":"Q7","category":"","question":"Lymphocytic choriomeningitis virus ditularkan melalui...","questionImages":[],"options":{"A":"Gigitan nyamuk Culex","B":"Urin hamster, tikus, dan mencit","C":"Jalur fekal-oral dari air tercemar","D":"Droplet dari saluran napas atas","E":"Kontak dengan cairan genital"},"answer":"B","explanation":"LCMV ditularkan lewat urin hamster, rat, dan mice.","explanationImages":[],"isBroken":false},{"id":"Q8","category":"","question":"Seorang anak demam tinggi, nyeri kepala, fotofobia, dan muntah. Pemeriksaan fisik menunjukkan kaku kuduk serta Brudzinski dan Kernig positif. Temuan tersebut disebut...","questionImages":[],"options":{"A":"Tanda gangguan otonom","B":"Tanda peningkatan TIK","C":"Tanda lesi upper motor neuron","D":"Tanda Cushing","E":"Tanda rangsang meningeal"},"answer":"E","explanation":"Kaku kuduk, Brudzinski (+), dan Kernig (+) adalah meningeal sign.","explanationImages":[],"isBroken":false},{"id":"Q9","category":"","question":"Kejang pada meningitis ditemukan pada sekitar...","questionImages":[],"options":{"A":"80–90% pasien","B":"1–5% pasien","C":"50–60% pasien","D":"20–30% pasien","E":"5–10% pasien"},"answer":"D","explanation":"Kejang terjadi pada 20–30% kasus meningitis.","explanationImages":[],"isBroken":false},{"id":"Q10","category":"","question":"Trias Cushing pada peningkatan TIK terdiri dari...","questionImages":[],"options":{"A":"Bradikardia, hipertensi, dan respirasi ireguler","B":"Takikardia, hipertensi, dan respirasi ireguler","C":"Bradikardia, hipertensi, dan demam tinggi","D":"Bradikardia, hipotensi, dan respirasi cepat","E":"Takikardia, hipotensi, dan respirasi cepat"},"answer":"A","explanation":"Cushing triad: bradikardia, hipertensi, respirasi ireguler.","explanationImages":[],"isBroken":false},{"id":"Q11","category":"","question":"Tanda klinis peningkatan TIK yang dapat dinilai dengan funduskopi adalah...","questionImages":[],"options":{"A":"Atrofi optik primer","B":"Ablasio retina","C":"Retinopati hipertensif","D":"Perdarahan vitreus","E":"Papiledema"},"answer":"E","explanation":"Papiledema merupakan tanda TIK meningkat, disertai nyeri kepala dan muntah proyektil.","explanationImages":[],"isBroken":false},{"id":"Q12","category":"","question":"Pemeriksaan penunjang pencitraan pada dugaan meningitis-ensefalitis yang dilakukan sebelum lumbal pungsi bila ada tanda TIK meningkat adalah...","questionImages":[],"options":{"A":"Foto polos tengkorak AP dan lateral","B":"EEG rutin dengan aktivasi","C":"USG transkranial melalui fontanela","D":"CT scan atau MRI kepala","E":"Rontgen toraks PA dan lateral"},"answer":"D","explanation":"Imaging (CT/MRI) dilakukan karena tanda peningkatan TIK merupakan kontraindikasi lumbal pungsi.","explanationImages":[],"isBroken":false},{"id":"Q13","category":"","question":"Perhatikan gambar CT scan berikut. Lesi berbentuk cincin dengan pusat hipodens dan edema sekitarnya paling sesuai dengan... ","questionImages":["images/packages/2h-persiapan-minites__infeksi-sistem-saraf/img-001.png"],"options":{"A":"Ensefalitis virus difus","B":"Abses serebri","C":"Hematoma subdural kronis","D":"Meningitis bakterial tanpa komplikasi","E":"Infark serebri lakunar"},"answer":"B","explanation":"Lesi ring enhancing dengan edema perifokal khas abses serebri, tahap lanjut meningitis.","explanationImages":[],"isBroken":false},{"id":"Q14","category":"","question":"Manakah yang BUKAN kontraindikasi lumbal pungsi?","questionImages":[],"options":{"A":"Papiledema dan tanda peningkatan TIK","B":"Gangguan napas atau ancaman herniasi","C":"Luka atau infeksi kulit pada area penusukan","D":"Nyeri kepala tanpa tanda TIK","E":"Gangguan hemostasis atau koagulopati"},"answer":"D","explanation":"Kontraindikasi LP: luka di area LP, gangguan napas, tanda TIK meningkat, gangguan hemostasis.","explanationImages":[],"isBroken":false},{"id":"Q15","category":"","question":"Hasil LCS: leukosit 1.500/µL dengan PMN 90%, glukosa 30 mg/dL, rasio glukosa LCS:darah 0,3, protein 200 mg/dL. Diagnosis yang paling mungkin adalah...","questionImages":[],"options":{"A":"Meningitis tuberkulosis","B":"Meningitis jamur","C":"Meningitis bakterial","D":"Abses parameningeal","E":"Meningitis viral"},"answer":"C","explanation":"Bakterial: leukosit >1.000, PMN ~90%, glukosa <40, rasio <0,4, protein >150.","explanationImages":[],"isBroken":false},{"id":"Q16","category":"","question":"Hasil LCS: leukosit 300/µL dominan limfosit, glukosa 35 mg/dL, rasio glukosa <0,4, protein 300 mg/dL. Diagnosis yang paling mungkin adalah...","questionImages":[],"options":{"A":"Meningitis tuberkulosis","B":"Abses parameningeal","C":"Meningitis bakterial akut","D":"Meningitis jamur kriptokokus","E":"Meningitis viral aseptik"},"answer":"A","explanation":"TB/jamur: leukosit 100–500, PMN <50%, glukosa 30–45, rasio <0,4, protein 100–500.","explanationImages":[],"isBroken":false},{"id":"Q17","category":"","question":"Gambaran LCS meningitis viral yang benar adalah...","questionImages":[],"options":{"A":"Leukosit >1.000, PMN 90%, glukosa <40, protein >150","B":"Leukosit 100–500, PMN <50%, glukosa 30–45, protein 100–500","C":"Leukosit 100–1.000, PMN <50%, glukosa normal, protein 50–100","D":"Leukosit >1.000, PMN <50%, glukosa <40, protein 50–100","E":"Leukosit 0–5, PMN 0–15%, glukosa 45–65, protein 20–45"},"answer":"C","explanation":"Viral: pleositosis mononuklear 100–1.000, glukosa normal 45–65, protein 50–100.","explanationImages":[],"isBroken":false},{"id":"Q18","category":"","question":"Nilai normal LCS menurut slide adalah...","questionImages":[],"options":{"A":"Leukosit 0–5, glukosa 30–45, protein 100–500","B":"Leukosit 0–15, glukosa 30–45, protein 20–45","C":"Leukosit 0–5, glukosa 45–65, protein 50–100","D":"Leukosit 5–10, glukosa 45–65, protein 45–100","E":"Leukosit 0–5, glukosa 45–65, protein 20–45"},"answer":"E","explanation":"Normal: leukosit 0–5, PMN 0–15%, glukosa 45–65, rasio 0,6, protein 20–45.","explanationImages":[],"isBroken":false},{"id":"Q19","category":"","question":"Terapi simptomatik untuk kejang pada meningitis-ensefalitis adalah...","questionImages":[],"options":{"A":"Ganciclovir, asiklovir, dan foscarnet","B":"Albendazol, prazikuantel, dan ivermektin","C":"Seftriakson, vankomisin, dan ampisilin","D":"Parasetamol, ibuprofen, dan kompres hangat","E":"Diazepam, fenitoin, midazolam, fenobarbital"},"answer":"E","explanation":"Antikejang: diazepam, fenitoin, midazolam, fenobarbital. Antipiretik: parasetamol/ibuprofen.","explanationImages":[],"isBroken":false},{"id":"Q20","category":"","question":"Antivirus yang digunakan pada ensefalitis herpes dan dosis asiklovirnya menurut slide adalah...","questionImages":[],"options":{"A":"Asiklovir 10 mg/kgBB/hari dosis tunggal","B":"Foscarnet 10 mg/kgBB/hari dosis tunggal","C":"Ganciclovir 10 mg/kgBB/hari terbagi 3 dosis","D":"Asiklovir 100 mg/kgBB/hari dosis tunggal","E":"Asiklovir 10 mg/kgBB/hari terbagi 3 dosis"},"answer":"E","explanation":"Asiklovir 10 mg/kgBB/hari terbagi 3 dosis; ganciclovir juga tersedia untuk CMV.","explanationImages":[],"isBroken":false},{"id":"Q21","category":"","question":"Antihelmintik yang digunakan pada neurosistiserkosis adalah...","questionImages":[],"options":{"A":"Albendazol dan prazikuantel","B":"Ampisilin dan seftriakson","C":"Pirimetamin dan klindamisin","D":"Amfoterisin B dan flukonazol","E":"Ganciclovir dan foscarnet"},"answer":"A","explanation":"Antihelmintik: albendazol dan prazikuantel.","explanationImages":[],"isBroken":false},{"id":"Q22","category":"","question":"Regimen antibiotik empiris meningitis bakterial pada pasien usia >50 tahun adalah...","questionImages":[],"options":{"A":"Ampisilin + sefotaksim","B":"Vankomisin + rifampisin","C":"Seftriakson + vankomisin","D":"Sefotaksim + gentamisin","E":"Ampisilin + seftriakson"},"answer":"E","explanation":"Usia >50 tahun: S. pneumoniae, N. meningitidis, L. monocytogenes, basil gram negatif → ampisilin + seftriakson.","explanationImages":[],"isBroken":false},{"id":"Q23","category":"","question":"Regimen antibiotik empiris pada pasien usia 18–50 tahun dengan meningitis bakterial adalah...","questionImages":[],"options":{"A":"Seftriakson + vankomisin","B":"Ampisilin + sefotaksim","C":"Sefotaksim + kloramfenikol","D":"Vankomisin + rifampisin","E":"Ampisilin + seftriakson"},"answer":"A","explanation":"Usia 3 bln–50 tahun: seftriakson + vankomisin; 0–1 bln: ampisilin + sefotaksim; 1–3 bln: ampisilin + seftriakson.","explanationImages":[],"isBroken":false},{"id":"Q24","category":"","question":"Bayi berusia 2 minggu dengan meningitis bakterial. Regimen empiris yang tepat adalah...","questionImages":[],"options":{"A":"Seftriakson + gentamisin","B":"Ampisilin + sefotaksim","C":"Vankomisin + rifampisin","D":"Seftriakson + vankomisin","E":"Ampisilin + seftriakson"},"answer":"B","explanation":"Usia 0–1 bulan (S. agalactiae, E. coli, Listeria): ampisilin + sefotaksim.","explanationImages":[],"isBroken":false},{"id":"Q25","category":"","question":"Pasien pasca bedah saraf dengan meningitis. Kuman yang paling mungkin adalah...","questionImages":[],"options":{"A":"Neisseria meningitidis dan Haemophilus influenzae tipe b","B":"Cryptococcus neoformans dan Toxoplasma gondii","C":"Streptococcus pneumoniae dan Listeria monocytogenes","D":"Pseudomonas aeruginosa dan Staphylococcus koagulase negatif","E":"Streptococcus agalactiae dan Escherichia coli enterik"},"answer":"D","explanation":"Pasca neurosurgery: P. aeruginosa dan coagulase-negative staphylococci.","explanationImages":[],"isBroken":false},{"id":"Q26","category":"","question":"Tujuan pemberian steroid pada terapi suportif meningitis-ensefalitis adalah...","questionImages":[],"options":{"A":"Membunuh bakteri penyebab secara langsung di LCS","B":"Menghentikan kejang berulang lewat efek antikonvulsan","C":"Mengontrol TIK dengan mengurangi edema parenkim otak","D":"Mencegah penularan kepada orang di sekitar pasien","E":"Menurunkan demam seperti antipiretik pada umumnya"},"answer":"C","explanation":"Kontrol ICP: steroid mengontrol edema pada parenkim otak.","explanationImages":[],"isBroken":false},{"id":"Q27","category":"","question":"Isolasi pada terapi suportif meningitis-ensefalitis terutama diperlukan pada...","questionImages":[],"options":{"A":"Pasien usia sekolah tanpa komorbid","B":"Pasien pasca operasi bedah saraf","C":"Pasien dengan hasil LCS normal","D":"Pasien immunocompromised","E":"Pasien dengan kejang tunggal"},"answer":"D","explanation":"Isolasi terutama pada pasien immunocompromised.","explanationImages":[],"isBroken":false},{"id":"Q28","category":"","question":"Hidrosefalus sebagai komplikasi meningitis terjadi akibat...","questionImages":[],"options":{"A":"Peningkatan produksi LCS oleh pleksus koroid saja","B":"Vaskulitis pembuluh darah otak","C":"Kerusakan sawar darah otak saja","D":"Obstruksi pada ruang subaraknoid","E":"Trombosis sinus dural"},"answer":"D","explanation":"Hidrosefalus akibat obstruksi di ruang subaraknoid; stroke terjadi karena vaskulitis.","explanationImages":[],"isBroken":false},{"id":"Q29","category":"","question":"Stroke sebagai komplikasi meningitis disebabkan oleh...","questionImages":[],"options":{"A":"Vaskulitis","B":"Empiema subdural","C":"Hidrosefalus obstruktif","D":"Abses serebri","E":"Epilepsi sekunder"},"answer":"A","explanation":"Stroke terjadi karena vaskulitis sebelumnya.","explanationImages":[],"isBroken":false},{"id":"Q30","category":"","question":"Faktor yang memperburuk prognosis meningitis-ensefalitis adalah...","questionImages":[],"options":{"A":"Kejang pada onset awal dan leukosit LCS tinggi","B":"Usia dewasa muda dan durasi sakit yang singkat","C":"Kultur LCS N. meningitidis tanpa syok maupun koma","D":"Status imunokompeten dan tidak ada komorbid","E":"Usia ekstrem, koma, syok, dan kultur LCS S. pneumoniae"},"answer":"E","explanation":"Prognosis buruk: umur ekstrem, durasi lama, kejang onset lanjut, koma, syok, WBC LCS rendah, immunocompromised, kultur S. pneumoniae.","explanationImages":[],"isBroken":false},{"id":"Q31","category":"","question":"Mielitis adalah...","questionImages":[],"options":{"A":"Infeksi pada selaput otak","B":"Infeksi pada sendi vertebra","C":"Infeksi pada parenkim otak","D":"Infeksi pada medula spinalis","E":"Infeksi pada akar saraf perifer"},"answer":"D","explanation":"Mielitis = infeksi pada mielum/medula spinalis; bersama ensefalitis disebut ADEM.","explanationImages":[],"isBroken":false},{"id":"Q32","category":"","question":"Mielitis yang terjadi bersamaan dengan ensefalitis disebut...","questionImages":[],"options":{"A":"ADEM","B":"Poliomielitis anterior","C":"Abses spinal epidural","D":"Sindrom Guillain-Barré","E":"Meningoensefalitis"},"answer":"A","explanation":"Mielitis + ensefalitis = ADEM.","explanationImages":[],"isBroken":false},{"id":"Q33","category":"","question":"Manifestasi klinis mielitis yang khas adalah...","questionImages":[],"options":{"A":"Kelemahan hanya pada wajah dan gangguan penciuman","B":"Penurunan kesadaran dengan kaku kuduk sebagai gejala utama","C":"Kelemahan anggota gerak dan gangguan sensibilitas sebatas lesi ke bawah","D":"Gangguan sensibilitas di seluruh tubuh sejak awal","E":"Kelemahan asimetris tanpa gangguan otonom maupun nyeri punggung"},"answer":"C","explanation":"Gejala: demam, kelemahan anggota gerak, gangguan sensibilitas sebatas lesi ke bawah, back pain, gangguan otonom, refleks patologis.","explanationImages":[],"isBroken":false},{"id":"Q34","category":"","question":"Perhatikan MRI spinal berikut (panah). Pemeriksaan penunjang ini dipilih pada dugaan mielitis karena... ","questionImages":["images/packages/2h-persiapan-minites__infeksi-sistem-saraf/img-002.png"],"options":{"A":"MRI hanya dipakai untuk menyingkirkan tumor otak","B":"MRI selalu dilakukan pada level lumbal saja tanpa memandang gejala","C":"MRI dapat menggantikan analisis LCS sepenuhnya","D":"MRI dapat menilai lesi medula spinalis sesuai level yang dicurigai","E":"MRI hanya menilai tulang vertebra tanpa jaringan lunak"},"answer":"D","explanation":"Imaging pada mielitis adalah MRI sesuai level medula spinalis yang dicurigai; tampak hiperintensitas intramedular.","explanationImages":[],"isBroken":false},{"id":"Q35","category":"","question":"Fisioterapi pada mielitis penting untuk mencegah...","questionImages":[],"options":{"A":"Kejang dan epilepsi sekunder","B":"Infeksi berulang dan sepsis","C":"Gangguan sawar darah otak","D":"Kontraktur sendi dan atrofi otot","E":"Peningkatan TIK dan hidrosefalus"},"answer":"D","explanation":"Gangguan gerak menyebabkan kontraktur sendi dan atrofi otot.","explanationImages":[],"isBroken":false},{"id":"Q36","category":"","question":"Komplikasi mielitis yang benar adalah...","questionImages":[],"options":{"A":"Kejang umum, koma, dan edema paru","B":"Tetraplegia atau paraplegia, back pain persisten, dan abses spinal","C":"Hidrofobia, hipersalivasi, dan apnea","D":"Hidrosefalus, stroke, dan developmental delay","E":"Trismus, opistotonus, dan risus sardonikus"},"answer":"B","explanation":"Komplikasi mielitis: tetra/paraplegia, persisten back pain, empiema subdural, abses spinal.","explanationImages":[],"isBroken":false},{"id":"Q37","category":"","question":"Spesies Plasmodium yang dapat menyebabkan malaria serebral dan paling berbahaya adalah...","questionImages":[],"options":{"A":"P. falciparum","B":"Plasmodium malariae","C":"Plasmodium vivax","D":"Plasmodium ovale","E":"Plasmodium knowlesi"},"answer":"A","explanation":"P. falciparum dapat menimbulkan malaria serebral.","explanationImages":[],"isBroken":false},{"id":"Q38","category":"","question":"Kriteria malaria serebral pada dewasa adalah malaria disertai...","questionImages":[],"options":{"A":"Kejang tunggal singkat dengan GCS 15","B":"Penurunan kesadaran dengan GCS <13","C":"Penurunan kesadaran dengan GCS <15","D":"Demam >40 °C tanpa gangguan kesadaran","E":"Penurunan kesadaran dengan GCS <9"},"answer":"E","explanation":"Dewasa GCS <9, anak Blantyre coma score <3, atau koma >30 menit setelah kejang.","explanationImages":[],"isBroken":false},{"id":"Q39","category":"","question":"Patogenesis malaria serebral adalah...","questionImages":[],"options":{"A":"Penekanan pusat kesadaran oleh toksin bakteri sekunder","B":"Invasi langsung parasit ke neuron kortikal dan glia","C":"Penyumbatan pembuluh darah otak oleh sitoadherens, sekuestrasi, dan rosetting","D":"Trombosis vena kortikal akibat hiperkoagulasi primer","E":"Demielinisasi akibat reaksi autoimun terhadap mielin"},"answer":"C","explanation":"Sitoadherens, sekuestrasi, rosetting, gangguan rheologi darah; TNF dan NO turut berperan.","explanationImages":[],"isBroken":false},{"id":"Q40","category":"","question":"Ensefalopati difus pada malaria falsiparum berat berhubungan dengan...","questionImages":[],"options":{"A":"Vaskulitis aseptik pada arteri besar","B":"Sekuestrasi mikrovaskuler serebral","C":"Invasi virus langsung ke parenkim otak","D":"Obstruksi pada ruang subaraknoid","E":"Abses multipel pada substansia alba"},"answer":"B","explanation":"Ensefalopati difus berhubungan dengan sekuestrasi mikrovaskuler serebral.","explanationImages":[],"isBroken":false},{"id":"Q41","category":"","question":"Gejala klinis malaria serebral yang benar adalah...","questionImages":[],"options":{"A":"Trismus, risus sardonikus, dan opistotonus dengan kesadaran baik","B":"Kelemahan tungkai simetris dengan batas sensibilitas yang jelas","C":"Hidrofobia, hipersalivasi, dan kontraksi otot faring saat minum","D":"Trias malaria, kejang umum, gangguan kesadaran 24–72 jam, dan hepatosplenomegali","E":"Demam siklik tanpa gangguan kesadaran, kejang, maupun hepatosplenomegali"},"answer":"D","explanation":"Trias malaria (demam, menggigil, berkeringat), nyeri kepala, gangguan mental, kejang umum, koma 24–72 jam, hepatosplenomegali.","explanationImages":[],"isBroken":false},{"id":"Q42","category":"","question":"Analisis LCS pada malaria serebral menunjukkan...","questionImages":[],"options":{"A":"Basil tahan asam positif","B":"PMN >1.000/µL","C":"Limfosit >15/µL","D":"Glukosa <20 mg/dL","E":"Kriptokokus pada tinta India"},"answer":"C","explanation":"LCS malaria serebral: peningkatan limfosit >15/µL.","explanationImages":[],"isBroken":false},{"id":"Q43","category":"","question":"Pemeriksaan pertama untuk memastikan diagnosis malaria pada pasien demam dengan penurunan kesadaran dari daerah endemis adalah...","questionImages":[],"options":{"A":"Sediaan darah tebal-tipis atau imunokromatografi","B":"Kultur LCS dan pewarnaan Gram pada LCS","C":"CT scan kepala tanpa kontras saja","D":"Elektroensefalografi dengan aktivasi","E":"Serologi HSV dan CMV pada serum dan LCS"},"a